# محرك التوليد: gemini (Nano Banana 2 من Google) أو openai
IMAGE_PROVIDER=gemini

# مفتاح Gemini API من aistudio.google.com > Get API key (يحتاج حساب فيه فوترة مفعّلة)
GEMINI_API_KEY=
# Nano Banana 2 = gemini-3.1-flash-image-preview  |  Nano Banana Pro = gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# نسبة الصورة ودقتها: 1K | 2K | 4K  (كل ما زادت الدقة زادت التكلفة والوقت)
IMAGE_ASPECT=3:4
IMAGE_RESOLUTION=2K

# (اختياري) بديل OpenAI إذا حطيت IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# كلمة مرور لوحة التاجر (إضافة منتجات وتوليد صور الموديلات)
OWNER_PASSWORD=
# حد التجارب لكل عميل في الساعة
TRYONS_PER_HOUR=20
PORT=3000
