# مفتاح OpenAI (من platform.openai.com > API keys). بدونه الموقع يشتغل بوضع العرض.
OPENAI_API_KEY=
# نموذج توليد الصور. غيّره لأحدث نموذج صور متوفر في حسابك.
OPENAI_IMAGE_MODEL=gpt-image-1
# الجودة: low | medium | high  (كل ما زادت الجودة زادت التكلفة والوقت)
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1536
# كلمة مرور لوحة التاجر (إضافة منتجات وتوليد صور الموديلات)
OWNER_PASSWORD=
# حد التجارب لكل عميل في الساعة
TRYONS_PER_HOUR=20
PORT=3000
